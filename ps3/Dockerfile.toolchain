# PS3 cross-toolchain (PPU + SPU + PSL1GHT/libgcm) build container.
# Produces /usr/local/ps3dev with powerpc64-ps3-elf-* and spu-elf-* toolchains.
#
# Two deliberate departures from the upstream Dockerfile:
#
#  1. Each toolchain stage is its own RUN layer, so a failure late in the
#     sequence does not discard 40 minutes of successful compilation.
#  2. Stage 009 (ps3libraries: zlib/png/freetype/ogg/vorbis) is skipped. Its
#     download URLs have rotted upstream -- libvorbis-1.3.5 is gone from
#     xiph.org -- and none of it is needed to build an emulator. Stages are
#     1,2,4,5,6,8 (003 and 007 do not exist upstream).
FROM debian:12-slim

ENV PS3DEV=/usr/local/ps3dev
ENV PSL1GHT=/usr/local/ps3dev
ENV PATH=${PATH}:/usr/local/ps3dev/bin:/usr/local/ps3dev/ppu/bin:/usr/local/ps3dev/spu/bin
ENV DEBIAN_FRONTEND=noninteractive
# The build scripts invoke $MAKE without -j; MAKEFLAGS gets us the cores anyway.
ENV MAKEFLAGS=-j8

RUN apt-get -y update && apt-get -y install \
      autoconf automake bison build-essential ca-certificates cmake flex git \
      libelf-dev libgmp-dev libmpfr-dev libmpc-dev libncurses5-dev libssl-dev \
      libtool-bin pkg-config texinfo wget zlib1g-dev python3 make patch \
      xz-utils bzip2 file gettext rsync unzip \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /build
WORKDIR /build
COPY . /build

RUN ./toolchain.sh 1 2>&1 | tail -40
RUN ./toolchain.sh 2 2>&1 | tail -60
RUN ./toolchain.sh 4 2>&1 | tail -20
RUN ./toolchain.sh 5 2>&1 | tail -40
RUN ./toolchain.sh 6 2>&1 | tail -60
RUN ./toolchain.sh 8 2>&1 | tail -40

# Fail loudly here rather than shipping a half-built toolchain.
# Binary names: the PPU tools are prefixed powerpc64-ps3-elf-*, but the SPU
# tools are plain spu-* (not spu-elf-*). PSL1GHT installs into ppu/include and
# ppu/lib rather than a psl1ght/ subdirectory, so probe for a header that only
# it provides.
RUN /usr/local/ps3dev/ppu/bin/powerpc64-ps3-elf-gcc --version && \
    /usr/local/ps3dev/spu/bin/spu-gcc --version && \
    test -f /usr/local/ps3dev/ppu/include/rsx/nv40.h && \
    test -f /usr/local/ps3dev/ppu/lib/libgcm_sys.a && \
    test -x /usr/local/ps3dev/bin/cgcomp && \
    echo "toolchain OK: PPU + SPU + PSL1GHT + cgcomp"

WORKDIR /work
